# Used by root pnpm dev / pnpm start. Copy to .env to override defaults.
NEWDAY_API_HOST=127.0.0.1
NEWDAY_API_PORT=3001
NEWDAY_API_ORIGIN=http://127.0.0.1:3001
NEWDAY_WEB_HOST=127.0.0.1
NEWDAY_WEB_PORT=3000
NEWDAY_WEB_ORIGIN=http://127.0.0.1:3000
# Omit for the default <repository>/data/newday.sqlite.
# NEWDAY_DATABASE_PATH=/absolute/path/to/newday.sqlite

# Agent generation is disabled until a provider is explicitly configured.
# Task titles/notes, today's user context, explicit preferences and recent
# recorded outcomes in the planning snapshot are sent only when generating.
NEWDAY_AGENT_PROVIDER=disabled
# NEWDAY_AGENT_PROVIDER=openai-compatible
# NEWDAY_AGENT_BASE_URL=https://api.openai.com/v1
# NEWDAY_AGENT_MODEL=your-approved-model-id
# NEWDAY_AGENT_API_KEY=replace-me
# Optional for an explicitly selected HTTP gateway: exact origin, no path.
# NEWDAY_AGENT_ALLOW_HTTP_ORIGIN=http://192.168.1.10:8080
# Optional only for models supporting this setting; otherwise leave unset.
# NEWDAY_AGENT_REASONING_EFFORT=none
NEWDAY_AGENT_TIMEOUT_MS=30000
NEWDAY_AGENT_MAX_OUTPUT_TOKENS=1200
# Each run makes at most 3 calls, including clarification and one format repair.
# Choose a provider, permitted data scope and monetary budget before live trials.
