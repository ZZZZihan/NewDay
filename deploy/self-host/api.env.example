# Install as /etc/newday/api.env (root:root, mode 0600).
# The API is reachable only from this host's loopback interface.
NEWDAY_API_HOST=127.0.0.1
NEWDAY_API_PORT=3001
NEWDAY_DATABASE_PATH=/var/lib/newday/newday.sqlite
# Replace this with the exact HTTPS origin served by nginx.
NEWDAY_WEB_ORIGIN=https://newday.example.com
# No model requests or provider credentials are needed for self-hosting.
NEWDAY_AGENT_PROVIDER=disabled
