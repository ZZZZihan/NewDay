{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@newday/core/*": [
        "./packages/core/src/*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "playwright.config.ts",
    "tooling/**/*.mjs",
    "tooling/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/*/dist",
    "apps/web/.next"
  ]
}
